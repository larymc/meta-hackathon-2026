# Copy to server/.env — never commit secrets.
# Demo mode needs NOTHING below. Leave MODEL_API_KEY empty for deterministic demo.
MODEL_API_KEY=
MODEL_NAME=muse-spark-1.3
MODEL_BASE_URL=https://api.meta.ai/v1
# Live GitHub (optional). Fine-grained token, Issues: read/write on ONE repo only.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Live WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=relais-verify
WHATSAPP_APP_SECRET=
# Fixed authorization mapping: customerId -> "owner/repo". AI can never choose a repo.
CUSTOMER_REPO_MAP={"demo-sarah":"Gaismas/demo-site"}
DEMO_REPO=Gaismas/demo-site
